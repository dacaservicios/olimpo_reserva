<!DOCTYPE html>
<html lang="es">
<head>
    <title>Instalar Olimpo Reservas</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#c9a227">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Olimpo Reservas">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" sizes="192x192" href="/imagenes/logo192.png">
    <link rel="apple-touch-icon" href="/imagenes/logo.png">
    <link rel="icon" href="/imagenes/favicon.png">
    <link href="/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/css/icons.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #030303;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        .frame {
            width: 100%;
            max-width: 430px;
            min-height: 100vh;
            background: #0d0d0d;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.75rem;
            position: relative;
        }
        /* Logo */
        .logo-wrap {
            width: 100px; height: 100px;
            border-radius: 24px;
            background: #1a1a1a;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 40px rgba(201,162,39,.3);
            overflow: hidden;
        }
        .logo-wrap img { width: 78px; height: 78px; object-fit: contain; }
        .app-name  { font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: .3rem; text-align: center; }
        .app-desc  { font-size: .9rem; color: #666; text-align: center; margin-bottom: 2rem; line-height: 1.5; }

        /* ── Pantalla WebView ── */
        #screenWebview { display: none; width: 100%; }
        .wv-alert {
            background: #1a1a1a;
            border: 1px solid #c9a22755;
            border-radius: 16px;
            padding: 1.5rem 1.25rem;
            text-align: center;
        }
        .wv-icon { font-size: 2.8rem; margin-bottom: .75rem; }
        .wv-title { color: #c9a227; font-size: 1.1rem; font-weight: 700; margin-bottom: .6rem; }
        .wv-text  { color: #aaa; font-size: .88rem; line-height: 1.6; margin-bottom: 1.25rem; }
        .wv-steps { list-style: none; text-align: left; }
        .wv-steps li {
            color: #ccc; font-size: .88rem; padding: .45rem 0;
            border-bottom: 1px solid #252525; display: flex; align-items: flex-start; gap: .6rem;
        }
        .wv-steps li:last-child { border-bottom: none; }
        .wv-num {
            min-width: 22px; height: 22px; background: #c9a227; color: #000;
            font-size: .72rem; font-weight: 700; border-radius: 50%;
            display: flex; align-items: center; justify-content: center; margin-top: 1px;
        }
        .wv-copy-btn {
            width: 100%; margin-top: 1rem; padding: .85rem;
            background: #c9a227; color: #000; font-size: .95rem; font-weight: 700;
            border: none; border-radius: 12px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: .5rem;
        }

        /* ── Pantalla iOS Safari ── */
        #screenIos { display: none; width: 100%; }
        .ios-steps { width: 100%; display: flex; flex-direction: column; gap: .75rem; }
        .ios-step {
            background: #1a1a1a;
            border-radius: 14px;
            padding: 1rem 1.1rem;
            display: flex; align-items: center; gap: 1rem;
        }
        .ios-step-num {
            min-width: 32px; height: 32px; background: #c9a227; color: #000;
            font-weight: 800; font-size: .95rem; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }
        .ios-step-text { color: #ccc; font-size: .9rem; line-height: 1.45; }
        .ios-step-text strong { color: #fff; }
        .ios-step-icon { font-size: 1.5rem; min-width: 28px; text-align: center; }
        .ios-note {
            margin-top: 1rem;
            background: #1a1a1a; border: 1px solid #2a2a2a;
            border-radius: 12px; padding: .85rem 1rem;
            color: #777; font-size: .8rem; line-height: 1.5; text-align: center;
        }

        /* ── Pantalla Android / Desktop ── */
        #screenAndroid { display: none; width: 100%; }
        .btn-install {
            width: 100%; padding: 1rem;
            background: #c9a227; color: #000;
            font-size: 1.05rem; font-weight: 700;
            border: none; border-radius: 14px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: .6rem;
            box-shadow: 0 4px 20px rgba(201,162,39,.35);
            transition: opacity .2s, transform .15s;
        }
        .btn-install:active { transform: scale(.97); }
        .btn-install:disabled { opacity: .45; cursor: not-allowed; transform: none; }
        .install-msg {
            margin-top: 1rem; font-size: .88rem; color: #aaa;
            text-align: center; line-height: 1.5; min-height: 1.5em;
        }
        .install-msg.success { color: #4caf50; }
        .install-msg.info    { color: #c9a227; }

        /* ── Pantalla ya instalada / standalone ── */
        #screenInstalled { display: none; width: 100%; text-align: center; }
        .installed-icon { font-size: 3.5rem; color: #4caf50; margin-bottom: 1rem; }
        .installed-title { color: #fff; font-size: 1.2rem; font-weight: 700; margin-bottom: .5rem; }
        .installed-text  { color: #777; font-size: .9rem; margin-bottom: 1.5rem; line-height: 1.5; }
        .btn-go {
            display: inline-flex; align-items: center; gap: .5rem;
            background: #c9a227; color: #000; font-weight: 700; font-size: 1rem;
            padding: .85rem 2rem; border: none; border-radius: 12px; cursor: pointer;
            text-decoration: none;
        }

        /* Badge inferior */
        .install-badge {
            display: inline-flex; align-items: center; gap: .35rem;
            background: #1a1a1a; border: 1px solid #2a2a2a;
            border-radius: 20px; padding: .3rem .9rem;
            font-size: .75rem; color: #666; margin-top: 2rem;
        }
        .install-badge i { color: #c9a227; }

        /* Flecha animada que apunta al botón Compartir de iOS */
        .ios-arrow-hint {
            position: fixed; bottom: 22px; left: 0; right: 0;
            display: flex; flex-direction: column; align-items: center;
            animation: bounce 1.4s ease-in-out infinite;
            pointer-events: none;
        }
        .ios-arrow-hint span { color: #c9a227; font-size: .8rem; font-weight: 600; margin-bottom: 4px; }
        .ios-arrow-hint i { font-size: 1.6rem; color: #c9a227; }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(6px); }
        }
    </style>
</head>
<body>
<div class="frame">

    <div class="logo-wrap">
        <img src="/imagenes/logo.png" alt="Olimpo">
    </div>
    <h1 class="app-name">Olimpo Reservas</h1>
    <p class="app-desc">Reserva tu cita en la barbería<br>directo desde tu pantalla de inicio.</p>

    <!-- ① Navegador interno (WebView) en iOS -->
    <div id="screenWebview">
        <div class="wv-alert">
            <div class="wv-icon">⚠️</div>
            <div class="wv-title">Abre esto en Safari</div>
            <div class="wv-text">Estás usando el navegador de una app (WhatsApp, Instagram, etc.).<br>Para instalar correctamente debes abrirlo en <strong>Safari</strong>.</div>
            <ul class="wv-steps">
                <li>
                    <span class="wv-num">1</span>
                    <span>Toca los tres puntos <strong>⋯</strong> o el ícono de Safari que aparece en la esquina de la pantalla.</span>
                </li>
                <li>
                    <span class="wv-num">2</span>
                    <span>Selecciona <strong>"Abrir en Safari"</strong> o <strong>"Abrir en el navegador"</strong>.</span>
                </li>
                <li>
                    <span class="wv-num">3</span>
                    <span>Una vez en Safari, sigue las instrucciones de instalación.</span>
                </li>
            </ul>
            <button class="wv-copy-btn" id="btnCopyUrl">
                <i class="las la-copy"></i> Copiar enlace para abrir en Safari
            </button>
        </div>
    </div>

    <!-- ② iOS Safari — instrucciones paso a paso -->
    <div id="screenIos">
        <div class="ios-steps">
            <div class="ios-step">
                <div class="ios-step-num">1</div>
                <div class="ios-step-icon">⬆️</div>
                <div class="ios-step-text">Toca el botón <strong>Compartir</strong> en la barra inferior de Safari.</div>
            </div>
            <div class="ios-step">
                <div class="ios-step-num">2</div>
                <div class="ios-step-icon">➕</div>
                <div class="ios-step-text">Desliza hacia abajo y toca <strong>"Agregar a inicio"</strong>.</div>
            </div>
            <div class="ios-step">
                <div class="ios-step-num">3</div>
                <div class="ios-step-icon">✅</div>
                <div class="ios-step-text">Toca <strong>"Agregar"</strong> en la esquina superior derecha. ¡Listo!</div>
            </div>
        </div>
        <div class="ios-note">
            <i class="las la-info-circle"></i>
            La app se abrirá sin barra de direcciones, igual que una app nativa.
        </div>
        <!-- Flecha apuntando al botón compartir -->
        <div class="ios-arrow-hint" id="iosArrow">
            <span>Toca Compartir aquí abajo</span>
            <i class="las la-angle-down"></i>
        </div>
    </div>

    <!-- ③ Android / Chrome Desktop — prompt automático -->
    <div id="screenAndroid">
        <button class="btn-install" id="btnInstalar">
            <i class="las la-download"></i>
            Instalar aplicación
        </button>
        <div class="install-msg" id="installMsg"></div>
    </div>

    <!-- ④ Ya instalada / modo standalone -->
    <div id="screenInstalled">
        <div class="installed-icon"><i class="las la-check-circle"></i></div>
        <div class="installed-title">¡App instalada!</div>
        <div class="installed-text">La app ya está en tu pantalla de inicio.<br>Toca el botón para ir al inicio.</div>
        <a href="/" class="btn-go">
            <i class="las la-sign-in-alt"></i> Ir al inicio
        </a>
    </div>

    <div class="install-badge">
        <i class="las la-lock"></i>
        Sin tienda de apps · Gratis
    </div>

</div>

<script>
(function () {
    var ua = navigator.userAgent;

    // Detección de plataforma
    var isIos        = /iphone|ipad|ipod/i.test(ua);
    var isAndroid    = /android/i.test(ua);
    var isInStandalone = window.matchMedia('(display-mode: standalone)').matches
                       || window.navigator.standalone === true;

    // Detecta navegador interno (WebView) en iOS:
    // Safari real tiene "Safari/" en el UA; los WebViews de apps (WhatsApp, Instagram, FB, TikTok, etc.) no lo tienen,
    // o tienen strings propios.
    var isIosSafari = isIos
        && /safari/i.test(ua)
        && !/crios|fxios|opios|mercury|instagram|fban|fbav|line|micromessenger|tiktok|twitter|linkedin|snapchat/i.test(ua);
    var isIosWebView = isIos && !isIosSafari && !isInStandalone;

    // Registrar service worker
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
    }

    // ── Si ya está en modo standalone → redirigir directo al login ───────
    if (isInStandalone) {
        window.location.replace('/');
        return;
    }

    // ── iOS WebView → instrucciones para abrir en Safari ────────────────
    if (isIosWebView) {
        show('screenWebview');
        document.getElementById('btnCopyUrl').addEventListener('click', function () {
            var url = window.location.href;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(function () {
                    document.getElementById('btnCopyUrl').innerHTML = '<i class="las la-check"></i> ¡Enlace copiado!';
                });
            } else {
                // Fallback
                var ta = document.createElement('textarea');
                ta.value = url;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                document.getElementById('btnCopyUrl').innerHTML = '<i class="las la-check"></i> ¡Enlace copiado!';
            }
        });
        return;
    }

    // ── iOS Safari → instrucciones con flecha animada ────────────────────
    if (isIosSafari) {
        show('screenIos');
        return;
    }

    // ── Android / Chrome / Desktop → BeforeInstallPrompt ─────────────────
    show('screenAndroid');

    var deferredPrompt = null;

    window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        deferredPrompt = e;
        setMsg('', '');
    });

    window.addEventListener('appinstalled', function () {
        setMsg('success', '<i class="las la-check-circle"></i> ¡App instalada! Búscala en tu pantalla de inicio.');
        document.getElementById('btnInstalar').disabled = true;
        deferredPrompt = null;
    });

    document.getElementById('btnInstalar').addEventListener('click', function () {
        if (deferredPrompt) {
            var btn = this;
            btn.disabled = true;
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(function (choice) {
                deferredPrompt = null;
                if (choice.outcome === 'dismissed') {
                    btn.disabled = false;
                    setMsg('info', 'Puedes instalarlo más tarde tocando este botón.');
                }
            });
            return;
        }
        // Si no hay prompt aún (página recién cargada)
        setMsg('info', 'Espera un momento y vuelve a intentarlo, o usa el menú del navegador para instalar.');
    });

    // Helpers
    function show(id) {
        ['screenWebview','screenIos','screenAndroid','screenInstalled'].forEach(function (s) {
            document.getElementById(s).style.display = (s === id) ? 'block' : 'none';
        });
    }
    function setMsg(type, html) {
        var el = document.getElementById('installMsg');
        el.className = 'install-msg ' + type;
        el.innerHTML = html;
    }
})();
</script>
</body>
</html>

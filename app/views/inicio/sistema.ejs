//  PUERTA 2 — Completar información (posponible, reaparece cada login)
// ═══════════════════════════════════════════════════════════════════════
function promptCompletaPerfil(faltan) {
    var etiquetas = { documento:'número de documento', celular:'celular', correo:'correo electrónico' };
    var lista = (faltan || []).map(function(f){ return '<li>' + (etiquetas[f] || f) + '</li>'; }).join('');
    Swal.fire({
        title: 'Completa tu información',
        html: '<div style="text-align:left;font-size:14px;">' +
              'Tener tus datos actualizados nos permite enviarte tus notificaciones y ' +
              'que accedas a <b>beneficios, ofertas y regalos</b>.' +
              (lista ? '<br><br>Falta o está incompleto:<ul id="perfilFaltantes">' + lista + '</ul>' : '') +
              '</div>',
        icon: 'info',
        showCancelButton: true,
        confirmButtonText: 'Completar ahora',
        cancelButtonText: 'Ahora no',
        customClass: { confirmButton: 'btn btn-primary', cancelButton: 'btn btn-secondary ms-1' },
        buttonsStyling: false,
        allowOutsideClick: false
    }).then(function(res){
        if (res.isConfirmed) abrirFormPerfil();
    });
}

async function abrirFormPerfil() {
    bloquea();

    // Si aún no tenemos los datos del cliente en memoria, los pedimos.
    if (!window._clienteInfo) {
        try {
            const rCli = await axios.get('/api/inicio/datos/' + verSesion(),
                { headers: { authorization: 'Bearer ' + verToken() } });
            window._clienteInfo = rCli.data.valor.info || {};
        } catch (e) { window._clienteInfo = {}; }
    }

    var c = window._clienteInfo || {};
    try {
        const rTipos = await axios.get('/api/parametro/detalle/listar/2/' + verSesion(),
            { headers: { authorization: 'Bearer ' + verToken() } });
        var tipos = (rTipos.data.valor.info || []).filter(function(t){ return t.ES_VIGENTE == 1; });
        var opts = tipos.map(function(t){
            var sel = (t.ID_PARAMETRO_DETALLE == c.ID_TIPO_DOCUMENTO) ? ' selected' : '';
            return '<option value="' + t.ID_PARAMETRO_DETALLE + '"' + sel + '>' + t.DESCRIPCIONDETALLE + '</option>';
        }).join('');
        document.getElementById('pfTipoDoc').innerHTML = '<option value="">Seleccione...</option>' + opts;
    } catch (e) {
        document.getElementById('pfTipoDoc').innerHTML = '<option value="35">Documento de identidad</option>';
    }
    desbloquea();

    document.getElementById('pfNombre').value    = c.NOMBRE || '';
    document.getElementById('pfPaterno').value   = c.APELLIDO_PATERNO || '';
    document.getElementById('pfMaterno').value   = c.APELLIDO_MATERNO || '';
    document.getElementById('pfDocumento').value = c.NUMERO_DOCUMENTO || '';
    document.getElementById('pfCelular').value   = c.NRO_CELULAR || '';
    document.getElementById('pfEmail').value     = c.EMAIL || '';
    document.getElementById('pfDireccion').value = c.DIRECCION || '';
    document.getElementById('pfFechaNac').value  = c.FECHA_NACIMIENTO ? moment(c.FECHA_NACIMIENTO).format('DD-MM-YYYY') : '';

    ['msgPfNombre','msgPfPaterno','msgPfMaterno','msgPfTipoDoc','msgPfDocumento','msgPfCelular','msgPfEmail','msgPfFechaNac']
        .forEach(function(id){ document.getElementById(id).textContent = ''; });

    document.getElementById('btnGuardaPerfil').onclick = _guardaPerfil;
    bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('offcanvasPerfil')).show();
}

async function _guardaPerfil() {
    var v = function(id){ return document.getElementById(id).value.trim(); };
    var m = function(id,msg){ document.getElementById(id).textContent = msg || ''; };
    var body = {
        nombre: v('pfNombre'),
        apellidoPaterno: v('pfPaterno'),
        apellidoMaterno: v('pfMaterno'),
        tipoDocumento: v('pfTipoDoc'),
        documento: v('pfDocumento'),
        celular: v('pfCelular'),
        email: v('pfEmail'),
        direccion: v('pfDireccion'),
        fechaNacimiento: v('pfFechaNac'),
        sesId: verSesion()
    };

    ['msgPfNombre','msgPfPaterno','msgPfMaterno','msgPfTipoDoc','msgPfDocumento','msgPfCelular','msgPfEmail','msgPfFechaNac']
        .forEach(function(id){ m(id,''); });

    var ok = true;
    if (!body.nombre)          { m('msgPfNombre','Campo obligatorio'); ok = false; }
    if (!body.apellidoPaterno) { m('msgPfPaterno','Campo obligatorio'); ok = false; }
    if (!body.apellidoMaterno) { m('msgPfMaterno','Campo obligatorio'); ok = false; }
    if (!body.tipoDocumento)   { m('msgPfTipoDoc','Selecciona un tipo'); ok = false; }
    if (!/^[0-9]{6,15}$/.test(body.documento)) { m('msgPfDocumento','Entre 6 y 15 dígitos'); ok = false; }
    if (!/^9[0-9]{8}$/.test(body.celular))     { m('msgPfCelular','Celular de 9 dígitos que empieza en 9'); ok = false; }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(body.email)) { m('msgPfEmail','Correo no válido'); ok = false; }
    if (body.fechaNacimiento && !/^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[012])-(19|20)[0-9]{2}$/.test(body.fechaNacimiento)) {
        m('msgPfFechaNac','Formato DD-MM-AAAA'); ok = false;
    }
    if (!ok) return;

    bloquea();
    try {
        const r = await axios.put('/api/acceso/datos/' + verSesion(), body,
            { headers: { authorization: 'Bearer ' + verToken() } });
        desbloquea();
        if (r.data.valor.resultado) {
            bootstrap.Offcanvas.getInstance(document.getElementById('offcanvasPerfil')).hide();
            await Swal.fire({ icon:'success', title:'¡Datos actualizados!', timer:1800, showConfirmButton:false });
            window.location.reload();
        } else {
            m('msgPfDocumento', r.data.valor.mensaje || 'No se pudo guardar.');
        }
    } catch (err) {
        desbloquea();
        var msg = (err.response && err.response.data && err.response.data.error)
                  ? err.response.data.error.message : 'Error de conexión';
        m('msgPfDocumento', msg);
    }
}

<script>
// ═══════════════════════════════════════════════════════════════════════
//  PUERTA 1 — Cambio de contraseña obligatorio (primer ingreso)
// ═══════════════════════════════════════════════════════════════════════
function mostrarGateCambiaPass() {
    document.body.classList.add('gate-lock');
    var doc = (window._clienteInfo && window._clienteInfo.NUMERO_DOCUMENTO) || '';

    document.getElementById('cuerpoPrincipal').innerHTML = `
      <div class="card gate-card">
        <div class="card-body text-center">
          <i class="las la-shield-alt gate-icon"></i>
          <h5 class="mt-2">Crea tu contraseña</h5>
          <p class="text-muted" style="font-size:13px;">
            Por seguridad, antes de continuar debes reemplazar la contraseña
            inicial (tu número de documento) por una nueva.
          </p>
          <div class="text-start">
            <div class="mb-2">
              <label>Contraseña nueva</label>
              <div class="gate-pass-wrap">
                <input id="gpNueva" type="password" class="form-control" maxlength="16" autocomplete="new-password">
                <i class="las la-low-vision gate-eye" data-target="gpNueva"></i>
              </div>

              <div class="gate-strength"><i id="gpBar"></i></div>
              <div class="gate-strength-label" id="gpBarLabel">Escribe tu contraseña</div>

              <ul class="gate-reqs">
                <li id="greqLen"><i class="las la-circle"></i> Entre 6 y 16 caracteres</li>
                <li id="greqMin"><i class="las la-circle"></i> Al menos una minúscula</li>
                <li id="greqMay"><i class="las la-circle"></i> Al menos una mayúscula</li>
                <li id="greqNum"><i class="las la-circle"></i> Al menos un número</li>
                <li id="greqEsp"><i class="las la-circle"></i> Al menos un carácter especial</li>
                <li id="greqDoc"><i class="las la-circle"></i> Distinta a tu número de documento</li>
              </ul>
              <div class="gate-msg" id="gpMsgNueva"></div>
            </div>
            <div class="mb-2">
              <label>Repite la contraseña nueva</label>
              <div class="gate-pass-wrap">
                <input id="gpRepite" type="password" class="form-control" maxlength="16" autocomplete="new-password">
                <i class="las la-low-vision gate-eye" data-target="gpRepite"></i>
              </div>
              <div class="gate-match" id="gpMatch"></div>
            </div>
            <button type="button" id="gpGuardar" class="btn btn-primary w-100" disabled>
              Guardar y continuar
            </button>
          </div>
        </div>
      </div>`;

    document.getElementById('gpNueva').oninput  = _gpSync;
    document.getElementById('gpRepite').oninput = _gpSync;
    document.getElementById('gpGuardar').onclick = function(){ _gpGuardar(doc); };

    // Mostrar / ocultar contraseña
    Array.prototype.forEach.call(document.querySelectorAll('.gate-eye'), function(eye){
        eye.onclick = function(){
            var inp = document.getElementById(eye.dataset.target);
            var show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            eye.className = 'las gate-eye ' + (show ? 'la-eye' : 'la-low-vision');
            eye.dataset.target = inp.id;
        };
    });

    window._gpDoc = String(doc || '');
    _gpSync();
}

// Evalúa cada regla y devuelve el mapa de cumplimiento.
function _gpRules(val) {
    var especiales = '!¡#$%&()*+-./:;=¿?@[]{|}';
    return {
        len: val.length >= 6 && val.length <= 16,
        min: /[a-záéíóúñ]/.test(val),
        may: /[A-ZÁÉÍÓÚÑ]/.test(val),
        num: /[0-9]/.test(val),
        esp: val.split('').some(function(c){ return especiales.indexOf(c) !== -1; }),
        doc: val.length > 0 && val !== (window._gpDoc || '')
    };
}

// Refresca checklist, barra de fuerza, coincidencia y estado del botón.
function _gpSync() {
    var nueva  = document.getElementById('gpNueva').value;
    var repite = document.getElementById('gpRepite').value;
    var r = _gpRules(nueva);

    var map = { greqLen:r.len, greqMin:r.min, greqMay:r.may, greqNum:r.num, greqEsp:r.esp, greqDoc:r.doc };
    Object.keys(map).forEach(function(id){
        var li = document.getElementById(id);
        if (!li) return;
        var was = li.classList.contains('met');
        li.classList.toggle('met', map[id]);
        var ic = li.querySelector('i');
        ic.className = 'las ' + (map[id] ? 'la-check-circle' : 'la-circle');
        if (map[id] && !was) { ic.style.animation = 'none'; void ic.offsetWidth; ic.style.animation = ''; }
    });

    var pasos = ['len','min','may','num','esp'].filter(function(k){ return r[k]; }).length;
    var pct = pasos * 20;
    var colores = ['#dc3545','#dc3545','#fd7e14','#ffc107','#28a745','#1e7e34'];
    var textos  = ['Muy débil','Muy débil','Débil','Aceptable','Buena','Fuerte'];
    var bar = document.getElementById('gpBar');
    var lbl = document.getElementById('gpBarLabel');
    bar.style.width = pct + '%';
    bar.style.backgroundColor = colores[pasos];
    lbl.textContent = nueva.length ? textos[pasos] : 'Escribe tu contraseña';
    lbl.style.color = nueva.length ? colores[pasos] : '#90a4ae';

    var m = document.getElementById('gpMatch');
    if (!repite.length) { m.textContent = ''; m.className = 'gate-match'; }
    else if (repite === nueva) { m.textContent = '✓ Las contraseñas coinciden'; m.className = 'gate-match ok'; }
    else { m.textContent = '✗ Las contraseñas no coinciden'; m.className = 'gate-match bad'; }

    var todo = r.len && r.min && r.may && r.num && r.esp && r.doc && repite === nueva && repite.length > 0;
    document.getElementById('gpGuardar').disabled = !todo;
    return todo;
}

async function _gpGuardar(doc) {
    var nueva  = document.getElementById('gpNueva').value.trim();
    var repite = document.getElementById('gpRepite').value.trim();
    document.getElementById('gpMsgNueva').textContent = '';

    if (!_gpSync()) { document.getElementById('gpMsgNueva').textContent = 'Revisa que se cumplan todas las condiciones.'; return; }

    bloquea();
    try {
        const r = await axios.put('/api/acceso/password/' + verSesion(),
            { contrasenaNueva: nueva, inicial: true },
            { headers: { authorization: 'Bearer ' + verToken() } }
        );
        desbloquea();
        if (r.data.valor.resultado) {
            await Swal.fire({ icon:'success', title:'¡Contraseña creada!', text:'Ya puedes usar la aplicación.', confirmButtonText:'Continuar', allowOutsideClick:false });
            window.location.reload();
        } else {
            document.getElementById('gpMsgNueva').textContent = r.data.valor.mensaje || 'No se pudo guardar.';
        }
    } catch (err) {
        desbloquea();
        var msg = (err.response && err.response.data && err.response.data.error)
                  ? err.response.data.error.message : 'Error de conexión';
        document.getElementById('gpMsgNueva').textContent = msg;
    }
}

